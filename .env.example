# Copy to .env for local runs, or set these as stack variables in Portainer.
POSTGRES_PASSWORD=change-me
# openssl rand -hex 32
SECRET_KEY=change-me
# python -m app.tools fernet-key
DATA_ENCRYPTION_KEY=change-me
ADMIN_USER=admin
# python -m app.tools hash-password   (argon2 hash, keep the $ characters)
ADMIN_PASSWORD_HASH=
# optional second factor: python -m app.tools totp-secret
ADMIN_TOTP_SECRET=
PUBLIC_BASE_URL=https://finance.example.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Zammad API user: read access to the Finance groups, write for notes, group and state
ZAMMAD_URL=https://support.example.com
ZAMMAD_TOKEN=
# bexio developer app (developer.bexio.com); redirect URL = PUBLIC_BASE_URL/auth/bexio/callback
BEXIO_CLIENT_ID=
BEXIO_CLIENT_SECRET=
# optional daily summary of open todos
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
HOST_PORT=8436
# host interface to bind to (LAN IP of the reverse proxy); default loopback
BIND_ADDR=127.0.0.1
TZ=Europe/Zurich
WORKER_INTERVAL_SECONDS=300
